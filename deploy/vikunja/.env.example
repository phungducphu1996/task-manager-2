# Hazel Vikunja staging config
# Copy this file to /opt/vikunja/.env and fill the Supabase secrets on the VPS.

# Public route behind nginx. Keep the trailing slash for sub-path deploys.
VIKUNJA_SERVICE_PUBLICURL=https://hazeleo.com/vikunja/
VIKUNJA_SERVICE_TIMEZONE=Asia/Ho_Chi_Minh

# Keep registration on only for first setup if you want to create users from the UI.
# After creating admin/users, set this to false and restart the container.
VIKUNJA_SERVICE_ENABLEREGISTRATION=true

# Local bind inside the container. The compose file exposes this only on 127.0.0.1:3456.
VIKUNJA_SERVICE_INTERFACE=:3456

# File persistence. This path is mounted from /opt/vikunja/files.
VIKUNJA_FILES_BASEPATH=/app/vikunja/files

# Supabase/Postgres. Use a database/schema dedicated to Vikunja, not teamtask_manager.
VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=replace-with-supabase-host
VIKUNJA_DATABASE_PORT=5432
VIKUNJA_DATABASE_USER=replace-with-supabase-user
VIKUNJA_DATABASE_PASSWORD=replace-with-supabase-password
VIKUNJA_DATABASE_DATABASE=replace-with-database-name
VIKUNJA_DATABASE_SCHEMA=vikunja
VIKUNJA_DATABASE_SSLMODE=require

# Optional hardening for staging. Replace with a long random string.
VIKUNJA_SERVICE_SECRET=replace-with-long-random-secret
